# ==========================================
# Alumni Tracking System - Environment Configuration
# ==========================================

# Server Port
PORT=3000

# Node Environment (development, test, production)
NODE_ENV=development

# Database URL (PostgreSQL Connection String)
# For local run: postgres://alumni_user:alumni_password@localhost:5432/alumni_db
# For Docker run: postgres://alumni_user:alumni_password@db:5432/alumni_db
DATABASE_URL=postgres://alumni_user:alumni_password@localhost:5432/alumni_db

# PostgreSQL Granular Credentials
POSTGRES_USER=alumni_user
POSTGRES_PASSWORD=alumni_password
POSTGRES_DB=alumni_db
DB_HOST=localhost
DB_PORT=5432
