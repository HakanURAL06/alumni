          }
        }
      }
    },
    "/users/{id}/edit": {
      "get": {
        "tags": ["User"],
        "summary": "Render alumni edit form (View Layer)",
        "description": "Renders an HTML edit form pre-filled with the current alumni details.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Edit form HTML rendered" },
          "404": { "description": "User not found" }
        }
      },
      "post": {
        "tags": ["User"],
        "summary": "Update alumni user via HTML form",
        "description": "Receives form submission data and redirects to /users with View feedback.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "302": { "description": "Redirects to /users?updated=1" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/users/{id}/delete": {
      "post": {
        "tags": ["User"],
        "summary": "Delete alumni user via HTML form button",
        "description": "Deletes the alumni user and redirects to /users with View feedback.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "302": { "description": "Redirects to /users?deleted=1" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check (GET)",
        "description": "Returns status ok in JSON format to verify API health.",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Health"],
        "summary": "Health check (POST)",
        "description": "Returns status ok in JSON format when requested via POST.",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/hello": {
      "get": {
        "tags": ["Utility"],
        "summary": "Static greeting",
        "responses": {
          "200": {
            "description": "Returns Hello World",
            "content": {
              "text/plain": {
                "schema": { "type": "string", "example": "Hello World" }
              }
            }
          }
        }
      }
    },
    "/hello/{name}": {
      "get": {
        "tags": ["Utility"],
        "summary": "Dynamic greeting",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Person name to greet"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns personalized greeting",
            "content": {
              "text/plain": {
                "schema": { "type": "string", "example": "Hello Hakan!" }
              }
            }
          }
        }
      }
    },
    "/sum/{number1}/{number2}": {
      "get": {
        "tags": ["Utility"],
        "summary": "Calculate sum of two numbers",
        "parameters": [
          {
            "name": "number1",
            "in": "path",
            "required": true,
            "schema": { "type": "number" },
            "description": "First number"
          },
          {
            "name": "number2",
            "in": "path",
            "required": true,
            "schema": { "type": "number" },
            "description": "Second number"
          }
        ],
        "responses": {
          "200": {
            "description": "Sum result",
            "content": {
              "text/plain": {
                "schema": { "type": "string", "example": "toplam= 8" }
              }
            }
          },
          "400": {
            "description": "Invalid number input"
          }
        }
      }
    },
    "/about": {
      "get": {
        "tags": ["Pages"],
        "summary": "About page HTML",
        "responses": {
          "200": { "description": "About page HTML" }
        }
      }
    },
    "/": {
      "get": {
        "tags": ["Pages"],
        "summary": "Temporary Home Page HTML",
        "responses": {
          "200": { "description": "Home page HTML" }
        }
      }
    },
    "/api/announcements": {
      "get": {
        "tags": ["ApiAnnouncement"],
        "summary": "List all announcements (JSON API)",
        "description": "Retrieves all announcements in JSON format via ApiAnnouncementController.",
        "responses": {
          "200": {
            "description": "List of announcements",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Announcement" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["ApiAnnouncement"],
        "summary": "Create announcement (JSON API)",
        "description": "Creates a new announcement via ApiAnnouncementController.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AnnouncementInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Announcement created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnnouncementResponse" }
              }
            }
          }
        }
      }
    },
    "/api/announcements/{id}": {
      "get": {
        "tags": ["ApiAnnouncement"],
        "summary": "Get announcement by ID (JSON API)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
