{
  "openapi": "3.0.0",
  "info": {
    "title": "Alumni Tracking System API",
    "version": "1.0.0",
    "description": "RESTful API and Web Services for the Alumni Tracking System. Demonstrates clean MVC architecture with separated routes (routes/user.js, routes/apiUser.js), controllers (UserController, ApiUserController), and in-memory model (UserModel)."
  },
  "tags": [
    {
      "name": "ApiUser",
      "description": "RESTful JSON API endpoints handled by ApiUserController via routes/apiUser.js (/apiuser and /api/users)"
    },
    {
      "name": "User",
      "description": "Web and Presentation endpoints handled by UserController via routes/user.js (/user and /users)"
    },
    {
      "name": "Health",
      "description": "Application health and status diagnostics"
    },
    {
      "name": "Utility",
      "description": "Utility endpoints (greetings and arithmetic calculator)"
    },
    {
      "name": "Pages",
      "description": "Application static and presentation HTML pages"
    },
    {
      "name": "ApiAnnouncement",
      "description": "RESTful JSON API endpoints handled by ApiAnnouncementController via routes/apiAnnouncement.js (/api/announcements)"
    },
    {
      "name": "Announcement",
      "description": "Web and Management Interface endpoints handled by AnnouncementController via routes/announcement.js (/announcements)"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development / Docker Server"
    }
  ],
  "paths": {
    "/apiuser": {
      "get": {
        "tags": ["ApiUser"],
        "summary": "List all alumni users (ApiUser route)",
        "description": "Retrieves all alumni profiles in JSON format via ApiUserController (routes/apiUser.js).",
        "responses": {
          "200": {
            "description": "List of alumni users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["ApiUser"],
        "summary": "Create a new alumni user (ApiUser route)",
        "description": "Creates a new alumni user record via ApiUserController.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/apiuser/{id}": {
      "get": {
        "tags": ["ApiUser"],
        "summary": "Get alumni user by ID (ApiUser route)",
        "description": "Retrieves an alumni profile by its numeric ID via ApiUserController.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["ApiUser"],
        "summary": "Update alumni user (PUT - ApiUser route)",
        "description": "Fully updates an existing alumni record via ApiUserController.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["ApiUser"],
        "summary": "Partially modify alumni user (PATCH - ApiUser route)",
        "description": "Partially modifies specific fields of an alumni record via ApiUserController.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserPartialInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User modified successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["ApiUser"],
        "summary": "Delete alumni user (DELETE - ApiUser route)",
        "description": "Deletes an alumni record via ApiUserController.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserDeleteResponse" }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["ApiUser"],
        "summary": "List all alumni users (/api/users endpoint)",
        "description": "Retrieves the full list of in-memory alumni users.",
        "responses": {
          "200": {
            "description": "List of alumni users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["ApiUser"],
        "summary": "Create a new alumni user (/api/users endpoint)",
        "description": "Adds a new alumni user to the in-memory store.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": ["ApiUser"],
        "summary": "Get alumni user by ID (/api/users/{id})",
        "description": "Retrieves a specific alumni profile by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["ApiUser"],
        "summary": "Update alumni user (PUT - /api/users/{id})",
        "description": "Updates fields of an existing alumni profile.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["ApiUser"],
        "summary": "Partially modify alumni user (PATCH - /api/users/{id})",
        "description": "Partially modifies specific fields of an alumni profile.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserPartialInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User modified successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["ApiUser"],
        "summary": "Delete alumni user (DELETE - /api/users/{id})",
        "description": "Removes an alumni user from the in-memory store.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserDeleteResponse" }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/user": {
      "get": {
        "tags": ["User"],
        "summary": "List alumni users (User route - HTML/JSON)",
        "description": "Renders an HTML directory table of alumni profiles (or JSON) handled by UserController (routes/user.js).",
        "responses": {
          "200": {
            "description": "Alumni directory view",
            "content": {
              "text/html": {
                "schema": { "type": "string" }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/User" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["User"],
        "summary": "Create alumni user (User route)",
        "description": "Creates a new user record and redirects to /users (for web forms) or returns 201 JSON.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            },
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "302": {
            "description": "Redirects to /users after form submission"
          }
        }
      }
    },
    "/user/{id}": {
      "get": {
        "tags": ["User"],
        "summary": "Get alumni profile by ID (User route)",
        "description": "Renders an HTML profile card for the specified alumni member via UserController.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Profile card view",
            "content": {
              "text/html": {
                "schema": { "type": "string" }
              },
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "put": {
        "tags": ["User"],
        "summary": "Update alumni user (User route - PUT)",
        "description": "Updates an alumni record via UserController.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "patch": {
        "tags": ["User"],
        "summary": "Partially update alumni user (User route - PATCH)",
        "description": "Partially modifies an alumni record via UserController.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserPartialInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User modified successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "delete": {
        "tags": ["User"],
        "summary": "Delete alumni user (User route - DELETE)",
        "description": "Deletes an alumni record via UserController.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserDeleteResponse" }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["User"],
        "summary": "List alumni directory (/users endpoint)",
        "description": "Renders an HTML directory table of alumni profiles handled by UserController.",
        "responses": {
          "200": {
            "description": "Alumni directory view"
          }
        }
      },
      "post": {
        "tags": ["User"],
        "summary": "Create alumni user (/users endpoint)",
        "description": "Creates a new user record via UserController.",
        "responses": {
          "201": {
            "description": "User created"
          }
        }
      }
    },
    "/users/{id}": {
